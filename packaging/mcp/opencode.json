{
  "mcp": {
    "rlm-mcp": {
      "type": "local",
      "command": [
        "{{RLM_BINARY}}"
      ],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "RLM_LOG_FORMAT": "pretty",
        "RLM_PROVIDER_SANDBOX": "strict",
        "RLM_ALLOW_NETWORK": "0"
      }
    }
  }
}